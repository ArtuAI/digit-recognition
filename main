"""
MNIST / Kaggle Digit Recognizer eksperimentas.

Programa:
1. Užkrauna train.csv.
2. Padalina duomenis į 80 % training ir 20 % validation.
3. Išbando kelias MLP architektūras.
4. Kiekvieną architektūrą paleidžia su keliais random seed.
5. Rezultatus saugo results/runs.csv.
6. Apmoko pasirinktą galutinį modelį su visu train.csv.
7. Prognozuoja Kaggle test.csv.
8. Sukuria results/submission.csv.
"""

import csv
import itertools
import os
import random
import time
from datetime import datetime

import numpy as np
import pandas as pd
import torch
import torch.nn as nn

from sklearn.model_selection import train_test_split
from torch.utils.data import DataLoader, TensorDataset


# ============================================================
# NUSTATYMAI
# ============================================================

DATA_PATH = "data/train.csv"
TEST_PATH = "data/test.csv"

RESULTS_PATH = "results/runs.csv"
SUBMISSION_PATH = "results/submission.csv"

DEVICE = torch.device(
    "cuda" if torch.cuda.is_available() else "cpu"
)

print("Naudojamas įrenginys:", DEVICE)


# ============================================================
# RANDOM SEED
# ============================================================

def set_seed(seed):
    """
    Užfiksuoja atsitiktinumą, kad eksperimentai būtų
    kiek įmanoma pakartojami.
    """

    random.seed(seed)
    np.random.seed(seed)

    torch.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)

    torch.backends.cudnn.deterministic = True
    torch.backends.cudnn.benchmark = False


# ============================================================
# DUOMENŲ UŽKROVIMAS
# ============================================================

def load_data(val_size=0.2, split_seed=42):
    """
    Užkrauna train.csv.

    X = 784 pikseliai
    y = teisingas skaitmuo

    Duomenys padalinami:
    80 % training
    20 % validation
    """

    df = pd.read_csv(DATA_PATH)

    X = (
        df.drop("label", axis=1)
        .values
        .astype(np.float32)
        / 255.0
    )

    y = (
        df["label"]
        .values
        .astype(np.int64)
    )

    X_train, X_val, y_train, y_val = train_test_split(
        X,
        y,
        test_size=val_size,
        random_state=split_seed,
        stratify=y
    )

    return (
        torch.from_numpy(X_train),
        torch.from_numpy(y_train),
        torch.from_numpy(X_val),
        torch.from_numpy(y_val)
    )


# ============================================================
# MLP MODELIS
# ============================================================

def build_mlp(hidden_sizes, dropout=0.0):
    """
    Pvz.:

    hidden_sizes = [256, 128]

    sukuria:

    784 -> 256 -> 128 -> 10
    """

    layers = []

    previous_size = 784

    for hidden_size in hidden_sizes:

        layers.append(
            nn.Linear(
                previous_size,
                hidden_size
            )
        )

        layers.append(
            nn.ReLU()
        )

        if dropout > 0:
            layers.append(
                nn.Dropout(dropout)
            )

        previous_size = hidden_size

    # 10 galimų skaitmenų: 0-9
    layers.append(
        nn.Linear(previous_size, 10)
    )

    return nn.Sequential(*layers)


def count_params(model):
    """Suskaičiuoja mokomų modelio parametrų skaičių."""

    return sum(
        parameter.numel()
        for parameter in model.parameters()
        if parameter.requires_grad
    )


# ============================================================
# MODELIO ĮVERTINIMAS
# ============================================================

@torch.no_grad()
def evaluate(model, loader, criterion):
    """
    Apskaičiuoja loss ir accuracy.
    Modelio svoriai čia nekeičiami.
    """

    model.eval()

    total_loss = 0.0
    correct = 0
    total = 0

    for X_batch, y_batch in loader:

        X_batch = X_batch.to(DEVICE)
        y_batch = y_batch.to(DEVICE)

        output = model(X_batch)

        loss = criterion(
            output,
            y_batch
        )

        total_loss += (
            loss.item()
            * y_batch.size(0)
        )

        predictions = output.argmax(
            dim=1
        )

        correct += (
            predictions == y_batch
        ).sum().item()

        total += y_batch.size(0)

    average_loss = total_loss / total
    accuracy = correct / total

    return average_loss, accuracy


# ============================================================
# VIENAS EKSPERIMENTAS
# ============================================================

def run_one(config, seed, data):
    """
    Apmoko vieną modelį naudojant vieną config ir vieną seed.
    """

    set_seed(seed)

    X_train, y_train, X_val, y_val = data

    train_loader = DataLoader(
        TensorDataset(
            X_train,
            y_train
        ),
        batch_size=config["batch_size"],
        shuffle=True
    )

    val_loader = DataLoader(
        TensorDataset(
            X_val,
            y_val
        ),
        batch_size=512,
        shuffle=False
    )

    model = build_mlp(
        config["hidden_sizes"],
        config["dropout"]
    ).to(DEVICE)

    criterion = nn.CrossEntropyLoss()

    optimizer = torch.optim.Adam(
        model.parameters(),
        lr=config["lr"]
    )

    best_val_acc = 0.0
    best_epoch = 0

    start_time = time.time()

    for epoch in range(config["epochs"]):

        model.train()

        for X_batch, y_batch in train_loader:

            X_batch = X_batch.to(DEVICE)
            y_batch = y_batch.to(DEVICE)

            # Išvalome ankstesnius gradientus
            optimizer.zero_grad()

            # Forward pass
            output = model(X_batch)

            # Loss
            loss = criterion(
                output,
                y_batch
            )

            # Backpropagation
            loss.backward()

            # Weight update
            optimizer.step()

        # Validation po kiekvienos epochos
        val_loss, val_acc = evaluate(
            model,
            val_loader,
            criterion
        )

        if val_acc > best_val_acc:
            best_val_acc = val_acc
            best_epoch = epoch + 1

    # Galutiniai rezultatai
    train_loss, train_acc = evaluate(
        model,
        train_loader,
        criterion
    )

    val_loss, final_val_acc = evaluate(
        model,
        val_loader,
        criterion
    )

    return {
        "timestamp": datetime.now().isoformat(
            timespec="seconds"
        ),

        "seed": seed,

        "hidden_sizes": "-".join(
            map(
                str,
                config["hidden_sizes"]
            )
        ),

        "dropout": config["dropout"],
        "lr": config["lr"],
        "batch_size": config["batch_size"],
        "epochs": config["epochs"],

        "n_params": count_params(model),

        "final_val_acc": round(
            final_val_acc,
            5
        ),

        "best_val_acc": round(
            best_val_acc,
            5
        ),

        "best_epoch": best_epoch,

        "final_val_loss": round(
            val_loss,
            5
        ),

        "final_train_acc": round(
            train_acc,
            5
        ),

        "train_minus_val": round(
            train_acc - final_val_acc,
            5
        ),

        "seconds": round(
            time.time() - start_time,
            1
        )
    }


# ============================================================
# REZULTATŲ IŠSAUGOJIMAS
# ============================================================

def append_result(row):

    os.makedirs(
        "results",
        exist_ok=True
    )

    write_header = (
        not os.path.exists(
            RESULTS_PATH
        )
    )

    with open(
        RESULTS_PATH,
        "a",
        newline="",
        encoding="utf-8"
    ) as file:

        writer = csv.DictWriter(
            file,
            fieldnames=list(
                row.keys()
            )
        )

        if write_header:
            writer.writeheader()

        writer.writerow(row)


# ============================================================
# GALUTINIO MODELIO MOKYMAS
# ============================================================

def train_final_model(config, seed=42):
    """
    Apmoko galutinį pasirinktą modelį naudojant
    VISUS train.csv duomenis.

    Tai darome tik po to, kai eksperimentais
    jau pasirinkome geriausią konfiguraciją.
    """

    set_seed(seed)

    df = pd.read_csv(
        DATA_PATH
    )

    X = (
        df.drop("label", axis=1)
        .values
        .astype(np.float32)
        / 255.0
    )

    y = (
        df["label"]
        .values
        .astype(np.int64)
    )

    X_tensor = torch.from_numpy(X)
    y_tensor = torch.from_numpy(y)

    train_loader = DataLoader(
        TensorDataset(
            X_tensor,
            y_tensor
        ),
        batch_size=config["batch_size"],
        shuffle=True
    )

    model = build_mlp(
        config["hidden_sizes"],
        config["dropout"]
    ).to(DEVICE)

    criterion = nn.CrossEntropyLoss()

    optimizer = torch.optim.Adam(
        model.parameters(),
        lr=config["lr"]
    )

    print(
        "\n--- Galutinio modelio mokymas ---"
    )

    for epoch in range(
        config["epochs"]
    ):

        model.train()

        total_loss = 0.0

        for X_batch, y_batch in train_loader:

            X_batch = X_batch.to(
                DEVICE
            )

            y_batch = y_batch.to(
                DEVICE
            )

            optimizer.zero_grad()

            output = model(
                X_batch
            )

            loss = criterion(
                output,
                y_batch
            )

            loss.backward()

            optimizer.step()

            total_loss += loss.item()

        average_loss = (
            total_loss
            / len(train_loader)
        )

        print(
            f"Epoch "
            f"{epoch + 1}/"
            f"{config['epochs']} | "
            f"loss: "
            f"{average_loss:.4f}"
        )

    return model


# ============================================================
# KAGGLE SUBMISSION
# ============================================================

def create_submission(model):
    """
    Užkrauna test.csv,
    modelis prognozuoja skaitmenis,
    sukuriamas submission.csv.
    """

    test_df = pd.read_csv(
        TEST_PATH
    )

    X_test = (
        test_df
        .values
        .astype(np.float32)
        / 255.0
    )

    X_test_tensor = torch.from_numpy(
        X_test
    )

    test_loader = DataLoader(
        X_test_tensor,
        batch_size=512,
        shuffle=False
    )

    predictions = []

    model.eval()

    with torch.no_grad():

        for X_batch in test_loader:

            X_batch = X_batch.to(
                DEVICE
            )

            output = model(
                X_batch
            )

            predicted_labels = output.argmax(
                dim=1
            )

            predictions.extend(
                predicted_labels
                .cpu()
                .numpy()
                .tolist()
            )

    submission = pd.DataFrame({
        "ImageId": range(
            1,
            len(predictions) + 1
        ),
        "Label": predictions
    })

    os.makedirs(
        "results",
        exist_ok=True
    )

    submission.to_csv(
        SUBMISSION_PATH,
        index=False
    )

    print(
        "\n--- Kaggle submission ---"
    )

    print(
        f"Failas sukurtas: "
        f"{SUBMISSION_PATH}"
    )

    print(
        f"Prognozių skaičius: "
        f"{len(predictions)}"
    )

    print(
        "\nPirmos prognozės:"
    )

    print(
        submission.head()
    )


# ============================================================
# EKSPERIMENTŲ KONFIGŪRACIJA
# ============================================================

BASE = {
    "hidden_sizes": [256, 128],
    "dropout": 0.0,
    "lr": 0.001,
    "batch_size": 64,
    "epochs": 10
}


# Keičiame tik architektūrą
GRID = {

    "hidden_sizes": [
        [128],
        [256, 128],
        [512, 256, 128]
    ]

}


# Kiekvieną modelį treniruojame kelis kartus
SEEDS = [
    0,
    1,
    2,
    3,
    4
]


# ============================================================
# GERIAUSIAS MODELIS
# ============================================================

# SVARBU:
#
# Čia turi įrašyti architektūrą,
# kuri tavo eksperimentuose gavo geriausią
# vidutinį validation rezultatą.

BEST_CONFIG = {
    "hidden_sizes": [512, 256, 128],
    "dropout": 0.0,
    "lr": 0.001,
    "batch_size": 64,
    "epochs": 10
}


# ============================================================
# MAIN
# ============================================================

def main():

    # --------------------------------------------------------
    # 1. Duomenys
    # --------------------------------------------------------

    data = load_data()

    keys = list(
        GRID.keys()
    )

    # --------------------------------------------------------
    # 2. Eksperimentai
    # --------------------------------------------------------

    print(
        "\n--- MLP architektūrų eksperimentas ---"
    )

    for values in itertools.product(
        *(GRID[key] for key in keys)
    ):

        config = {
            **BASE,
            **dict(
                zip(keys, values)
            )
        }

        for seed in SEEDS:

            row = run_one(
                config,
                seed,
                data
            )

            append_result(
                row
            )

            print(
                f"{row['hidden_sizes']:>15} | "
                f"seed {seed} | "
                f"val_acc "
                f"{row['final_val_acc']:.4f} | "
                f"best "
                f"{row['best_val_acc']:.4f} | "
                f"gap "
                f"{row['train_minus_val']:+.4f} | "
                f"{row['seconds']}s"
            )

    # --------------------------------------------------------
    # 3. Eksperimentų suvestinė
    # --------------------------------------------------------

    df = pd.read_csv(
        RESULTS_PATH
    )

    print(
        "\n--- Rezultatų suvestinė ---"
    )

    summary = (
        df.groupby(
            "hidden_sizes"
        )["final_val_acc"]
        .agg(
            ["mean", "std", "count"]
        )
        .sort_values(
            "mean",
            ascending=False
        )
        .round(4)
    )

    print(
        summary
    )

    # --------------------------------------------------------
    # 4. Final model
    # --------------------------------------------------------

    print(
        "\nNaudojamas BEST_CONFIG:"
    )

    print(
        BEST_CONFIG
    )

    final_model = train_final_model(
        BEST_CONFIG
    )

    # --------------------------------------------------------
    # 5. Kaggle submission
    # --------------------------------------------------------

    create_submission(
        final_model
    )


# ============================================================
# PALEIDIMAS
# ============================================================

if __name__ == "__main__":
    main()